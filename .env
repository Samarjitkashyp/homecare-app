# Backend API URL — this is the ONLY thing you need to edit to switch backends.
# After changing it, do a full "flutter run" restart (not just hot reload)
# so the app re-reads this file.
#
# Examples:
#   Android emulator          -> http://10.0.2.2/homecare/
#   Physical device (any OS)  -> http://<your-computer's-LAN-IP>/homecare/
#   iOS Simulator on the Mac
#   running the backend       -> http://localhost/homecare/
BASE_URL=http://192.168.0.237/homecare/

# App Config
APP_NAME=Absolute Choice Homecare
APP_VERSION=1.0.0

# Optional Features
ENABLE_OFFLINE_MODE=false
ENABLE_PUSH_NOTIFICATIONS=false